# Copia este archivo a `.env.local` y rellena los valores.
# En Vercel se configuran en Project Settings → Environment Variables.

# Project URL (Settings → API en el panel de Supabase)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# anon public key (Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key

# UUID de la fila única en la tabla `collections`
# (lo devuelve el INSERT inicial; ver README sección Supabase)
VITE_COLLECTION_ID=00000000-0000-0000-0000-000000000000
